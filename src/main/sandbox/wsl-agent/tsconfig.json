{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020"],
    "outDir": "../../../../dist-wsl-agent",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "moduleResolution": "Node16"
  },
  "include": ["*.ts"],
  "exclude": ["node_modules"]
}
