{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2022",
    "module": "Node16",
    "lib": ["ES2022"],
    "outDir": "../../../../dist-lima-agent",
    "rootDir": "../../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "moduleResolution": "Node16"
  },
  "include": ["*.ts"],
  "exclude": ["node_modules"]
}
