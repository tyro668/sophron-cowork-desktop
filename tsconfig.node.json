{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "node_modules/.cache/tsconfig.node",
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.node/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "scripts/pi-sdk-resolve.ts"]
}
