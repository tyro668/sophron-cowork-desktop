{
  "schemaVersion": "1.0",
  "name": "Metis Cowork",
  "organization": "Metis Cowork Team",
  "repository": "ssh://git@code.fineres.com:7999/res/metis-cowork.git",
  "releases": "Official Metis Cowork release channel",
  "license": {
    "name": "MIT",
    "file": "LICENSE"
  },
  "version": "3.3.0",
  "lastReviewed": "2026-05-01",
  "description": "Local data-processing AI agent desktop app for Windows and macOS with sandbox isolation, multi-model support, built-in Skills, MCP integration, GUI automation, and remote control.",
  "applicationCategory": "DeveloperApplication",
  "platforms": ["Windows", "macOS"],
  "prebuiltInstallerTypes": {
    "Windows": ".exe",
    "macOS": ".dmg"
  },
  "sourceBuild": {
    "node": ">=22.22.1",
    "commands": ["npm install", "npm run rebuild", "npm run dev"]
  },
  "install": [
    {
      "platform": "Windows and macOS",
      "method": "Official release channel"
    }
  ],
  "capabilities": [
    "Local data-processing AI agent workspace",
    "File, spreadsheet, report, and dataset analysis",
    "Multi-model provider configuration",
    "Built-in Skills for PPTX, DOCX, XLSX, and PDF workflows",
    "Model Context Protocol tool integration",
    "GUI automation through computer use",
    "Remote control through Feishu (Lark) and Slack",
    "Workspace path restrictions",
    "VM sandbox isolation with WSL2 and Lima when available"
  ],
  "modelProviders": [
    {
      "name": "OpenRouter",
      "baseUrl": "https://openrouter.ai/api",
      "recommendedModels": ["claude-4-5-sonnet"]
    },
    {
      "name": "Anthropic",
      "baseUrl": "default",
      "recommendedModels": ["claude-4-5-sonnet"]
    },
    {
      "name": "Zhipu AI / GLM",
      "baseUrl": "https://open.bigmodel.cn/api/anthropic",
      "recommendedModels": ["glm-4.7", "glm-4.6"]
    },
    {
      "name": "MiniMax",
      "baseUrl": "https://api.minimaxi.com/anthropic",
      "recommendedModels": ["minimax-m2"]
    },
    {
      "name": "Kimi",
      "baseUrl": "https://api.kimi.com/coding/",
      "recommendedModels": ["kimi-k2"]
    }
  ],
  "securityAndPrivacy": {
    "localFirst": true,
    "workspaceBoundary": "File operations are restricted to the selected workspace folder.",
    "vmIsolation": ["WSL2 on Windows", "Lima on macOS"],
    "dataPolicy": "Metis Cowork runs locally; the external network path is the AI model API configured by the user. The project website states that Metis Cowork does not send data to Metis Cowork servers."
  },
  "machineReadableResources": {
    "llmsTxt": "website/public/llms.txt",
    "llmsFullTxt": "website/public/llms-full.txt",
    "projectJson": "website/public/project.json",
    "robots": "website/public/robots.txt"
  },
  "sourcePages": ["README.md", "README_zh.md"]
}
