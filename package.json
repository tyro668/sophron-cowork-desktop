{
  "name": "sophron",
  "version": "10.1.0",
  "description": "Local data-processing AI agent desktop app for Windows & macOS with sandbox isolation, multi-model support, MCP tools, and Skills",
  "keywords": [
    "ai-agent",
    "electron",
    "desktop-app",
    "mcp",
    "sandbox",
    "open-source",
    "data-processing",
    "local-agent",
    "spreadsheet-analysis",
    "ai-coding",
    "ai-tools",
    "computer-use",
    "openai",
    "gemini",
    "deepseek",
    "skills",
    "pptx-generator",
    "docx",
    "feishu",
    "slack",
    "multi-model"
  ],
  "repository": {
    "type": "git",
    "url": "ssh://git@code.fineres.com:7999/res/metis-cowork.git"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "npm run download:node && npm run build:wsl-agent && npm run build:lima-agent && npm run build:mcp && vite --config vite.config.ts",
    "dev:with-python": "npm run download:node && npm run prepare:python && npm run build:wsl-agent && npm run build:lima-agent && npm run build:mcp && vite --config vite.config.ts",
    "build": "node scripts/build-brands.js all",
    "build:sophron": "node scripts/build-brands.js sophron",
    "build:sophron-cn": "node scripts/build-brands.js sophron-cn",
    "build:win": "node scripts/build-windows.js",
    "build:wsl-agent": "tsc -p src/main/sandbox/wsl-agent/tsconfig.json",
    "build:lima-agent": "tsc -p src/main/sandbox/lima-agent/tsconfig.json",
    "build:mcp": "node scripts/bundle-mcp.js",
    "download:node": "node scripts/download-node.js",
    "postinstall": "patch-package && install-electron && node scripts/download-node.js && npm run rebuild",
    "prepare": "husky",
    "prepare:gui-tools": "node scripts/prepare-gui-tools.js",
    "prepare:python": "node scripts/prepare-python.js",
    "prepare:python:all": "node scripts/prepare-python.js --all",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "node scripts/run-vitest-with-electron.js",
    "test:node": "vitest",
    "test:electron": "node scripts/run-vitest-with-electron.js",
    "test:memory": "node scripts/run-vitest-with-electron.js run src/tests/memory",
    "test:coverage": "node scripts/run-vitest-with-electron.js run --coverage",
    "bench": "vitest bench",
    "bench:api": "node scripts/bench-api.mjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc -b",
    "pre-build-check": "node scripts/pre-build-check.js",
    "clean": "rimraf dist dist-electron dist-mcp dist-wsl-agent dist-lima-agent .bundle-resources release",
    "deploy:local": "bash scripts/deploy-local.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@daypicker/react": "10.0.2",
    "@duckdb/node-api": "1.5.6-r.1",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@glideapps/glide-data-grid": "6.0.3",
    "@google/genai": "2.28.0",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-switch": "1.3.8",
    "@slack/bolt": "5.1.0",
    "@slack/web-api": "8.2.0",
    "@wecom/aibot-node-sdk": "1.0.7",
    "@xyflow/react": "12.12.0",
    "acorn": "8.19.0",
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.3",
    "chevrotain": "13.2.0",
    "chokidar": "5.0.0",
    "croner": "10.0.1",
    "dingtalk-stream": "2.1.7-beta.1",
    "dotenv": "18.0.6",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "extract-zip": "2.0.1",
    "glob": "13.0.6",
    "highlight.js": "11.12.0",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "katex": "0.19.0",
    "lucide-react": "1.52.0",
    "ngrok": "5.0.0-beta.2",
    "openai": "7.30.0",
    "patch-package": "8.0.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.0.16",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwind-merge": "3.7.0",
    "typebox": "1.3.36",
    "typescript": "6.0.3",
    "uuid": "14.0.2",
    "ws": "8.22.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.2",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "vite": "8.3.3",
    "vite-plugin-electron": "1.1.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "fast-xml-parser": "5.11.2",
    "tar": "7.5.22",
    "katex": "$katex"
  },
  "author": "sophron",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
